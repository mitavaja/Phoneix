# 🌐 SERVER
PORT=9000
NODE_ENV=development

# APP
APP_URL=http://localhost:9000
CLIENT_WEBSITE_URL=http://localhost:9001
CLIENT_ADMIN_URL=http://localhost:9002
CLIENT_CRM_URL=http://localhost:9003

# 🗄️ DATABASE
MONGO_URI=mongodb://127.0.0.1:27017/phreight_commerce

# 🔐 JWT AUTH
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# 👤 USER / SENDER PROFILE
FIRST_NAME=Admin
LAST_NAME=User
EMAIL_FROM=support@phreights.com
SENDER_EMAIL=support@phreights.com
SENDER_MOBILE=+919876543210
SENDER_CITY=Surat
SENDER_POSTCODE=395010
SENDER_COUNTRY=India

# 📦 ARAMEX API (Optional / Sandbox)
ARAMEX_USERNAME=test.api@aramex.com
ARAMEX_PASSWORD=your_aramex_password
ARAMEX_ACCOUNT_NUMBER=your_account_number
ARAMEX_ACCOUNT_PIN=your_account_pin
ARAMEX_ENTITY=BOM
ARAMEX_COUNTRY_CODE=IN
ARAMEX_SOURCE=24

# 💳 RAZORPAY
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 🚚 COURIER GATEWAY
